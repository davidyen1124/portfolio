{
  "extends": [
    "html-validate:recommended"
  ],
  "elements": [
    "html5"
  ],
  "rules": {
    "void-style": "off",
    "no-trailing-whitespace": "error",
    "attribute-boolean-style": "error",
    "doctype-style": "error",
    "no-dup-id": "error",
    "valid-id": "error",
    "prefer-button": "error"
  }
}
